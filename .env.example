# Copie ce fichier en .env.development / .env.staging / .env.production
# Ne jamais commiter de vraies cles — voir docs/adr/006-offline-first.md pour
# le detail de la strategie de separation des environnements.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# RevenueCat (sandbox en dev/staging)
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# OpenAI — NE JAMAIS renseigner cote client. Cette cle vit uniquement dans
# les secrets des Supabase Edge Functions (supabase secrets set OPENAI_API_KEY=...)
OPENAI_API_KEY=

# Observabilite
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN est un secret de build uniquement. Le configurer dans
# EAS/CI avec une visibilite Sensitive, jamais dans un fichier .env commite
# ni dans app.config.ts/extra.
POSTHOG_API_KEY=

# Prix suisses live (recherche par produit et optimisation de liste). Ce flag
# rend seulement le binaire capable de demander son eligibilite : l'Edge
# Function reste l'unique autorite et refuse tout compte hors cohorte.
SWISS_GROCERIES_ENABLED=false
# Secrets Edge Function uniquement, jamais exposes dans app.config.ts :
# SWISS_GROCERIES_GATEWAY_URL=
# SWISS_GROCERIES_GATEWAY_API_KEY=
# SWISS_GROCERIES_SERVER_ENABLED=false  # coupe-circuit Edge, secret serveur
# SWISS_GROCERIES_SERVER_MODE=off        # off | canary | on
# SWISS_GROCERIES_CANARY_USER_IDS=       # 1 a 10 UUID Auth, secret serveur
# Gateway conteneur uniquement :
# GATEWAY_API_KEY=  # secret aleatoire de 32 caracteres minimum
# MAX_IN_FLIGHT=4

# Environnement
APP_ENV=development
